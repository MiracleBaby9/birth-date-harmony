# Vercel Production Env Vars (set in dashboard)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Frontend (Vite)
VITE_RAZORPAY_KEY_ID=your_key_id

# Payment API base
# Production can use your deployed domain. Local vercel dev can use http://localhost:8080
# VITE_PAYMENT_API_BASE=https://miraclebaby.ankshaastra.com
# VITE_PAYMENT_API_BASE=https://ankshaastra.com

# VITE_PAYMENT_API_BASE=http://localhost:8081

VITE_PAYMENT_API_BASE=https://miraclebaby.ankshaastra.com

# Dynamic package names and prices. Prices must be plain INR numbers without currency symbols.
# Do not put the price in *_NAME. For example, name = Essentials Package, price = 1.
VITE_PACKAGE_ESSENTIALS_NAME=Essentials Package
# VITE_PACKAGE_ESSENTIALS_PRICE=1097
VITE_PACKAGE_ESSENTIALS_PRICE=1
VITE_PACKAGE_COMPLETE_NAME=Complete Package
VITE_PACKAGE_COMPLETE_PRICE=3167

# Email notifications (SMTP, used after successful payment)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_or_app_password
SMTP_REJECT_UNAUTHORIZED=true
FROM_EMAIL=Ankshaastra Miracle Baby <your_email@example.com>
ADMIN_EMAIL=miraclebaby@ankshaastra.in

# WhatsApp Business Cloud API notifications/webhook
WHATSAPP_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ADMIN_NUMBER=919667305577
WHATSAPP_VERIFY_TOKEN=ankshaastra_webhook_verify


